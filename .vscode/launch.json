  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch development",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main_development.dart",
      "toolArgs": [
        "--flavor",
        "development"
      ]
    },
    {
      "name": "Launch staging",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main_staging.dart",
      "toolArgs": ["--flavor", "staging"]
    },
    {
      "name": "Launch production",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main_production.dart",
      "toolArgs": ["--flavor", "production"]
    }
  ]
}
